# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# data.gov.in API key (free signup at data.gov.in)
DATA_GOV_IN_API_KEY=

# OpenAQ v3 API key (free signup at openaq.org)
OPENAQ_API_KEY=

# MySQL connection. Use a restricted user for the loaders, not root.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=india_air_quality